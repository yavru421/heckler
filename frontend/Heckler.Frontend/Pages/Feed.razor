@page "/"
@inject HecklerApi Api
@inject IdentityService Identity
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="mmo-venue-container">
    <!-- Top Venue Broadcast Header -->
    <header class="venue-header glass-panel">
        <div class="broadcast-status">
            <span class="live-indicator"></span>
            <span class="broadcast-title">MMO MAIN STAGE</span>
        </div>

        <div class="edge-tech-badge" title="State persistence & real-time broadcast powered by Cloudflare Durable Objects">
            <span class="bolt-glow">⚡</span>
            <span>POWERED BY <strong class="orange-glow">DURABLE OBJECTS</strong></span>
        </div>

        <div class="presence-badge">
            <span class="icon">👥</span>
            <span>@(stageState?.ListenersCount ?? 42) LISTENERS IN VENUE</span>
        </div>

        <div class="next-joke-countdown">
            <span class="timer-icon">⏳</span> NEXT SET IN: <strong class="timer-seconds">@(GetSecondsRemaining())s</strong>
        </div>

        <div class="vip-table-promo">
            <span class="vip-badge">⭐ VIP FEATURE</span>
            <a href="/rooms" class="btn-vip">Host a Table</a>
        </div>
    </header>

    <div class="mmo-grid-layout">
        <!-- Main Spotlight Stage & Performer (Center Left) -->
        <main class="stage-hall glass-panel glow-border">
            <div class="spotlight-overlay"></div>

            @if (stageState != null)
            {
                <div class="performer-badge">
                    <span class="mic-icon">🎙️</span> ON STAGE NOW: <strong class="performer-name">@@@stageState.Performer</strong>
                </div>

                <div class="joke-teleprompter glass-panel">
                    <p class="teleprompter-text">
                        @if (!string.IsNullOrEmpty(stageState.Text))
                        {
                            var cleanJokeText = System.Text.RegularExpressions.Regex.Replace(stageState.Text, @"\[PAUSE(?::[0-9.]+)?\]", " ");
                            var words = cleanJokeText.Split(new[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
                            int totalWords = words.Length;
                            int activeIndex = audioProgress <= 0.0 ? -1 : (int)Math.Min(Math.Floor(audioProgress * totalWords), totalWords - 1);
                            
                            for (int i = 0; i < totalWords; i++)
                            {
                                var isSpoken = i < activeIndex;
                                var isCurrent = i == activeIndex;
                                <span class="karaoke-word @(isCurrent ? "word-active" : isSpoken ? "word-spoken" : "word-pending")">@words[i] </span>
                            }
                        }
                    </p>
                    <div class="category-pill">@stageState.Category</div>
                </div>

                <!-- Synchronized Audio Player Controls -->
                <div class="broadcast-player">
                    @if (isPlaying)
                    {
                        <button class="btn-audio btn-playing" @onclick="ToggleAudio">
                            <span class="pulse-wave">🔊</span> BROADCASTING LIVE (SYNCED)
                        </button>
                    }
                    else
                    {
                        <button class="btn-audio btn-play" @onclick="ToggleAudio">
                            ▶️ TUNE INTO LIVE STAGE AUDIO
                        </button>
                    }
                </div>

                <!-- Live Audience Reaction Soundboard -->
                <div class="soundboard-panel">
                    <div class="soundboard-header">INTERACT WITH THE STAGE (BROADCAST TO EVERYONE)</div>
                    <div class="soundboard-buttons">
                        <button class="btn-react btn-laugh" @onclick='() => React("laugh")'>
                            😂 LAUGH <span class="count">(@(stageState.Reactions.GetValueOrDefault("laugh", 0)))</span>
                        </button>
                        <button class="btn-react btn-clap" @onclick='() => React("clap")'>
                            👏 CLAP <span class="count">(@(stageState.Reactions.GetValueOrDefault("clap", 0)))</span>
                        </button>
                        <button class="btn-react btn-boo" @onclick='() => React("boo")'>
                            🍅 BOO <span class="count">(@(stageState.Reactions.GetValueOrDefault("boo", 0)))</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="stage-loading">
                    <div class="spinner">🎙️</div>
                    <p>Connecting to Main Stage Broadcast...</p>
                </div>
            }

            <!-- Visual Crowd Seating Grid -->
            <div class="crowd-grid-panel">
                <div class="crowd-header">AUDIENCE SEATING</div>
                <div class="crowd-seats">
                    @for (int i = 0; i < 18; i++)
                    {
                        var isUser = (i == 0);
                        <div class="seat @(isUser ? "seat-user" : "seat-active")" title="@(isUser ? "You" : $"Listener #{i+100}")">
                            <span>@(isUser ? "👤" : "🪑")</span>
                        </div>
                    }
                </div>
            </div>
        </main>

        <!-- Live Audience Chat & Heckle Feed (Right Sidebar) -->
        <aside class="chat-sidebar glass-panel">
            <div class="chat-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span>💬 STAGE HECKLES</span>
                <span style="font-size: 0.75rem; color: var(--neon-blue);">@@@myUsername</span>
            </div>

            <!-- Nametag input bar -->
            <div class="nametag-bar" style="display: flex; gap: 0.4rem; margin-bottom: 0.6rem; background: rgba(0,0,0,0.3); padding: 0.4rem; border-radius: 6px; border: 1px solid var(--surface-border);">
                <span style="font-size: 0.8rem; color: var(--text-secondary); align-self: center;">🏷️ Name:</span>
                <input type="text" @bind="myUsername" placeholder="Enter your nametag..." style="flex: 1; padding: 0.25rem 0.5rem; border-radius: 4px; border: 1px solid var(--surface-border); background: black; color: #00f0ff; font-size: 0.8rem; font-weight: bold;" />
            </div>

            <div class="chat-messages-container">
                @if (stageState?.ChatMessages != null)
                {
                    @foreach (var msg in stageState.ChatMessages)
                    {
                        <div class="chat-bubble @(msg.Username == myUsername ? "mine" : "")">
                            <div class="chat-author">@@@msg.Username <span class="time">@msg.Timestamp</span></div>
                            <div class="chat-text">@msg.Message</div>
                        </div>
                    }
                }
            </div>

            <div class="chat-input-area">
                <input type="text" @bind="chatInputText" @onkeyup="HandleChatKeyUp" placeholder="Shout a heckle or comment..." class="chat-input" />
                <button class="btn-send-chat" @onclick="SendChat">SEND 📣</button>
            </div>
        </aside>
    </div>
</div>

<style>
    .mmo-venue-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
    }

    .venue-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 1.5rem;
        border-radius: 14px;
        background: rgba(15, 15, 20, 0.85);
    }

    .broadcast-status { display: flex; align-items: center; gap: 0.6rem; }
    .live-indicator {
        width: 10px; height: 10px; border-radius: 50%; background: #ff3366;
        box-shadow: 0 0 10px #ff3366; animation: blink 1.2s infinite;
    }

    @@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

    .broadcast-title { font-family: 'Oswald', sans-serif; letter-spacing: 2px; color: var(--neon-purple); font-weight: 700; }
    
    .edge-tech-badge {
        font-family: 'Oswald', sans-serif;
        font-size: 0.8rem;
        letter-spacing: 1px;
        color: rgba(255, 255, 255, 0.9);
        background: linear-gradient(135deg, rgba(243, 128, 32, 0.15), rgba(157, 78, 221, 0.2));
        border: 1px solid rgba(243, 128, 32, 0.5);
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(243, 128, 32, 0.25);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .bolt-glow { color: #f38020; filter: drop-shadow(0 0 6px #f38020); animation: boltPulse 1.5s infinite alternate; }
    .orange-glow { color: #00f0ff; text-shadow: 0 0 8px rgba(0, 240, 255, 0.6); }

    .presence-badge { font-size: 0.85rem; color: var(--neon-blue); font-family: 'Oswald', sans-serif; letter-spacing: 1px; }

    .next-joke-countdown {
        font-family: 'Oswald', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 1px;
        color: #ffd700;
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.3);
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .timer-seconds {
        font-size: 1.1rem;
        color: var(--neon-green);
        min-width: 28px;
        display: inline-block;
        text-align: center;
    }

    .vip-table-promo { display: flex; align-items: center; gap: 0.5rem; }
    .vip-badge { font-size: 0.7rem; background: rgba(255, 215, 0, 0.15); color: #ffd700; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: bold; }
    .btn-vip { color: white; text-decoration: none; font-size: 0.85rem; font-family: 'Oswald', sans-serif; border: 1px solid rgba(255,215,0,0.4); padding: 0.3rem 0.8rem; border-radius: 6px; }

    .mmo-grid-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 1rem;
    }

    .stage-hall {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        overflow: hidden;
        min-height: 480px;
    }

    .spotlight-overlay {
        position: absolute; top: 0; left: 50%; transform: translateX(-50%);
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(157, 78, 221, 0.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .performer-badge { font-family: 'Oswald', sans-serif; font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 1rem; }
    .performer-name { color: var(--neon-purple); font-size: 1.4rem; }

    .joke-teleprompter {
        width: 100%; max-width: 650px; padding: 1.5rem; border-radius: 12px;
        background: rgba(0,0,0,0.4); border: 1px solid var(--surface-border); margin-bottom: 1.5rem;
    }

    .teleprompter-text { font-size: 1.3rem; line-height: 1.6; color: white; margin: 0 0 1rem 0; min-height: 80px; }
    .karaoke-word { transition: all 0.15s ease; display: inline-block; margin-right: 0.25rem; }
    .word-pending { color: rgba(255,255,255,0.35); filter: blur(0.3px); }
    .word-spoken { color: #ffffff; text-shadow: 0 0 5px rgba(255,255,255,0.4); }
    .word-active { color: #00f0ff; font-weight: 700; transform: scale(1.1); text-shadow: 0 0 12px #00f0ff; }
    .category-pill { display: inline-block; font-size: 0.75rem; text-transform: uppercase; color: var(--neon-blue); letter-spacing: 1px; border: 1px solid var(--neon-blue); padding: 0.2rem 0.6rem; border-radius: 12px; }

    .broadcast-player { margin-bottom: 1.5rem; width: 100%; max-width: 400px; }
    .btn-audio {
        width: 100%; padding: 0.8rem 1.5rem; border-radius: 30px; font-family: 'Oswald', sans-serif;
        font-size: 1rem; cursor: pointer; transition: all 0.3s ease; border: none;
    }
    .btn-play { background: linear-gradient(135deg, var(--neon-purple), var(--neon-blue)); color: white; }
    .btn-playing { background: rgba(0,255,136,0.15); border: 1px solid var(--neon-green); color: var(--neon-green); }

    .soundboard-panel { width: 100%; max-width: 650px; margin-bottom: 1.5rem; }
    .soundboard-header { font-size: 0.75rem; color: var(--text-secondary); font-family: 'Oswald', sans-serif; letter-spacing: 1px; margin-bottom: 0.6rem; }
    .soundboard-buttons { display: flex; justify-content: center; gap: 0.8rem; flex-wrap: wrap; }
    .btn-react {
        padding: 0.6rem 1.2rem; border-radius: 20px; font-family: 'Oswald', sans-serif;
        background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: white; cursor: pointer;
    }
    .btn-laugh:hover { border-color: var(--neon-green); color: var(--neon-green); }
    .btn-clap:hover { border-color: var(--neon-blue); color: var(--neon-blue); }
    .btn-boo:hover { border-color: var(--neon-red); color: var(--neon-red); }

    .crowd-grid-panel { width: 100%; border-top: 1px solid var(--surface-border); padding-top: 1rem; }
    .crowd-header { font-size: 0.75rem; color: var(--text-secondary); font-family: 'Oswald', sans-serif; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .crowd-seats { display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap; }
    .seat { width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
    .seat-user { border: 1px solid var(--neon-purple); background: rgba(157,78,221,0.2); }

    .chat-sidebar { display: flex; flex-direction: column; height: 500px; padding: 1rem; }
    .chat-header { font-family: 'Oswald', sans-serif; font-size: 0.9rem; letter-spacing: 1px; color: var(--neon-blue); margin-bottom: 0.8rem; border-bottom: 1px solid var(--surface-border); padding-bottom: 0.5rem; }
    .chat-messages-container { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.6rem; padding-right: 0.4rem; }
    .chat-bubble { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.85rem; }
    .chat-bubble.mine { border-color: var(--neon-purple); background: rgba(157,78,221,0.08); }
    .chat-author { font-size: 0.75rem; color: var(--neon-purple); font-weight: bold; margin-bottom: 0.2rem; }
    .chat-author .time { color: var(--text-secondary); font-weight: normal; margin-left: 0.4rem; }
    .chat-text { color: white; line-height: 1.4; }

    .chat-input-area { display: flex; gap: 0.5rem; margin-top: 0.8rem; }
    .chat-input { flex: 1; padding: 0.5rem; border-radius: 6px; border: 1px solid var(--surface-border); background: black; color: white; font-size: 0.85rem; }
    .btn-send-chat { padding: 0.5rem 0.8rem; border-radius: 6px; border: none; background: var(--neon-purple); color: white; font-family: 'Oswald', sans-serif; font-size: 0.8rem; cursor: pointer; }

    @@media (max-width: 850px) {
        .mmo-venue-container {
            padding: 0.5rem;
            gap: 0.75rem;
        }

        .venue-header {
            flex-direction: column;
            gap: 0.5rem;
            text-align: center;
            padding: 0.8rem 1rem;
        }

        .mmo-grid-layout {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .stage-hall {
            padding: 1rem;
            min-height: auto;
        }

        .joke-teleprompter {
            padding: 1rem;
        }

        .teleprompter-text {
            font-size: 1.05rem;
            line-height: 1.5;
            min-height: 60px;
        }

        .soundboard-buttons {
            gap: 0.4rem;
        }

        .btn-react {
            padding: 0.5rem 0.8rem;
            font-size: 0.85rem;
        }

        .chat-sidebar {
            height: 350px;
            padding: 0.75rem;
        }
    }
</style>

@code {
    private LiveStageState? stageState = null;
    private bool isPlaying = false;
    private bool isPolling = true;
    private string chatInputText = "";
    private string myUsername = "AnonymousListener";
    private double audioProgress = 0.0;
    private DotNetObjectReference<Feed>? objRef;

    protected override async Task OnInitializedAsync()
    {
        myUsername = await Identity.GetUsernameAsync() ?? "Listener_" + Random.Shared.Next(100, 999);
        objRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("audioInterop.registerProgressCallback", objRef);
        await PollStageAsync();
        _ = StartPollingLoop();
        _ = StartUiTickerLoop();
    }

    private int GetSecondsRemaining()
    {
        if (stageState == null || stageState.StartedAt == 0 || stageState.DurationMs == 0) return 0;
        long elapsedMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - stageState.StartedAt;
        long remainingMs = stageState.DurationMs - elapsedMs;
        return (int)Math.Max(0, Math.Ceiling(remainingMs / 1000.0));
    }

    private async Task StartUiTickerLoop()
    {
        while (isPolling)
        {
            await Task.Delay(1000);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void UpdateAudioProgress(double progress)
    {
        audioProgress = Math.Clamp(progress, 0.0, 1.0);
        StateHasChanged();
    }

    private async Task StartPollingLoop()
    {
        while (isPolling)
        {
            await Task.Delay(2000); // 2s broadcast sync loop
            await PollStageAsync();
        }
    }

    private async Task PollStageAsync()
    {
        try
        {
            var updated = await Api.GetLiveStageAsync();
            if (updated != null)
            {
                var jokeChanged = (stageState != null && stageState.JokeId != updated.JokeId);
                stageState = updated;

                if (jokeChanged && isPlaying)
                {
                    // Force-cancel previous playing audio and snap immediately to current stage joke
                    await JS.InvokeVoidAsync("audioInterop.stopAllAudio");
                    await PlayCurrentBroadcastAudio();
                }
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task ToggleAudio()
    {
        isPlaying = !isPlaying;
        if (isPlaying)
        {
            await PlayCurrentBroadcastAudio();
        }
    }

    private async Task PlayCurrentBroadcastAudio()
    {
        if (stageState == null) return;
        await JS.InvokeVoidAsync("audioInterop.unlockAudio");
        
        string fullAudioUrl = Api.GetApiUrl(stageState.AudioUrl);

        bool isFemale = (stageState.Performer ?? "").Contains("Sarah", StringComparison.OrdinalIgnoreCase);
        var played = await JS.InvokeAsync<bool>("audioInterop.playAudioUrl", fullAudioUrl, stageState.Text ?? "", isFemale, stageState.Performer ?? "");
        if (!played && !string.IsNullOrEmpty(stageState.Text))
        {
            await JS.InvokeAsync<bool>("audioInterop.speakText", stageState.Text, isFemale, stageState.Performer ?? "");
        }
    }

    private async Task React(string type)
    {
        if (stageState == null) return;
        await Api.ReactLiveStageAsync(type);
        _ = JS.InvokeVoidAsync("audioInterop.playSynthSound", type);
        await PollStageAsync();
    }

    private async Task SendChat()
    {
        if (string.IsNullOrWhiteSpace(chatInputText)) return;
        var txt = chatInputText;
        chatInputText = "";
        await Api.SendStageChatAsync(myUsername, txt);
        await PollStageAsync();
    }

    private async Task HandleChatKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendChat();
        }
    }

    public void Dispose()
    {
        isPolling = false;
        objRef?.Dispose();
    }
}
