@page "/lineups"
@inject HecklerApi Api
@inject IdentityService Identity
@inject NavigationManager Nav

<div class="heckler-app">
    <header class="app-header glass-panel" style="border-radius: 0 0 16px 16px; margin-bottom: 2rem; border-top: none;">
        <div class="logo">
            <h1>RADIO <span class="neon-text">PLAYLISTS</span></h1>
        </div>
        <button class="haptic-btn" @onclick='() => Nav.NavigateTo("/feed")' style="padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid var(--neon-purple); background: transparent; color: var(--neon-purple); font-family: 'Oswald', sans-serif;">🎙️ LIVE STAGE</button>
    </header>

    <main class="stage-container" style="max-width: 900px;">
        <!-- Featured Radio Playlists -->
        <h2 style="font-size: 1.3rem; color: var(--neon-cyan); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;">📻 Curated Station Playlists</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2.5rem;">
            @foreach (var playlist in curatedPlaylists)
            {
                <div class="glass-panel" style="padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(0, 243, 255, 0.2); background: rgba(10, 10, 20, 0.6); transition: transform 0.2s ease;">
                    <div>
                        <div style="font-size: 2rem; margin-bottom: 0.5rem;">@playlist.Icon</div>
                        <h3 style="margin: 0 0 0.4rem 0; font-size: 1.05rem; color: white;">@playlist.Name</h3>
                        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.3; margin-bottom: 1rem;">@playlist.Description</p>
                    </div>
                    <button class="haptic-btn" @onclick="() => SelectPlaylist(playlist.Id)" style="padding: 0.5rem 1rem; border-radius: 6px; border: none; background: var(--neon-cyan); color: black; font-family: 'Oswald', sans-serif; font-size: 0.85rem; font-weight: bold; width: 100%;">TUNE IN ▶</button>
                </div>
            }
        </div>

        @if (selectedTracks.Count > 0)
        {
            <div class="glass-panel" style="padding: 1.5rem; margin-bottom: 2rem; border-color: var(--neon-cyan);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h3 style="margin: 0; color: var(--neon-cyan); font-size: 1.1rem;">🎶 Playing Playlist: @activePlaylistName</h3>
                    <span style="font-size: 0.8rem; color: var(--text-secondary);">@selectedTracks.Count Tracks Loaded</span>
                </div>

                @if (currentTrack != null)
                {
                    <div style="padding: 1rem; border-radius: 8px; background: rgba(0,243,255,0.05); border: 1px solid var(--neon-cyan); margin-bottom: 1rem; text-align: center;">
                        <span style="font-size: 0.75rem; color: var(--neon-cyan); text-transform: uppercase; letter-spacing: 1px;">Now Playing Track @(currentTrackIndex + 1) of @selectedTracks.Count</span>
                        <h4 style="margin: 0.4rem 0; font-size: 1.1rem; color: white;">"@currentTrack.Title"</h4>
                        <span style="font-size: 0.85rem; color: var(--text-secondary);">Performer: @currentTrack.Performer • Category: @currentTrack.Category</span>
                        <audio src="@currentTrack.AudioUrl" autoplay controls @onended="PlayNextTrack" style="width: 100%; margin-top: 1rem; height: 40px;"></audio>
                    </div>
                }

                <div style="max-height: 200px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem;">
                    @for (int i = 0; i < selectedTracks.Count; i++)
                    {
                        var index = i;
                        var track = selectedTracks[i];
                        var isCurrent = index == currentTrackIndex;
                        <div @onclick="() => PlayTrackAtIndex(index)" style="padding: 0.6rem; border-radius: 6px; background: @(isCurrent ? "rgba(0,243,255,0.15)" : "rgba(0,0,0,0.3)"); border: 1px solid @(isCurrent ? "var(--neon-cyan)" : "transparent"); cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: @(isCurrent ? "var(--neon-cyan)" : "white"); font-size: 0.85rem;">@(index + 1). @track.Title</span>
                            <span style="font-size: 0.75rem; color: var(--text-secondary);">@@@track.Performer</span>
                        </div>
                    }
                </div>
            </div>
        }
    </main>
</div>

@code {
    private List<PlaylistModel> curatedPlaylists = new();
    private List<PlaylistTrackModel> selectedTracks = new();
    private PlaylistTrackModel? currentTrack;
    private int currentTrackIndex = 0;
    private string activePlaylistName = "";

    protected override async Task OnInitializedAsync()
    {
        curatedPlaylists = await Api.GetPlaylistsAsync();
    }

    private async Task SelectPlaylist(string playlistId)
    {
        var playlist = curatedPlaylists.FirstOrDefault(p => p.Id == playlistId);
        if (playlist != null) activePlaylistName = playlist.Name;

        selectedTracks = await Api.GetPlaylistTracksAsync(playlistId);
        if (selectedTracks.Count > 0)
        {
            currentTrackIndex = 0;
            currentTrack = selectedTracks[0];
        }
        StateHasChanged();
    }

    private void PlayTrackAtIndex(int index)
    {
        if (index >= 0 && index < selectedTracks.Count)
        {
            currentTrackIndex = index;
            currentTrack = selectedTracks[index];
            StateHasChanged();
        }
    }

    private void PlayNextTrack()
    {
        if (currentTrackIndex + 1 < selectedTracks.Count)
        {
            currentTrackIndex++;
            currentTrack = selectedTracks[currentTrackIndex];
        }
        else
        {
            // Loop back to start
            currentTrackIndex = 0;
            currentTrack = selectedTracks[0];
        }
        StateHasChanged();
    }
}
