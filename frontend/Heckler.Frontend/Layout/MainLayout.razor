@inherits LayoutComponentBase

<div class="app-wrapper">
    <header class="app-header">
        <div class="header-left">
            <div class="logo">
                <h1 class="neon-text fade-in-text">HECKLER</h1>
                <div class="logo-subtitle">LIVE ONLINE COMEDY CLUB</div>
            </div>
            <div class="do-power-badge" title="Powered by Cloudflare Durable Objects Edge Architecture">
                <span class="do-bolt">⚡</span>
                <span class="do-label">POWERED BY <strong class="do-highlight">DURABLE OBJECTS</strong></span>
                <span class="do-glow-dot"></span>
            </div>
            <nav class="nav-links">
                <a href="/">MMO Stage</a>
                <a href="/rooms">VIP Tables</a>
                <a href="/lineups">Playlists</a>
            </nav>
        </div>
        <div class="header-right">
            @if (Identity.IsAuthenticated)
            {
                <div class="user-pill">
                    <span class="user-email">👤 @Identity.CurrentUser?.Email</span>
                    <span class="tier-badge @(Identity.IsPremium ? "tier-premium" : "tier-standard")">
                        @(Identity.CurrentUser?.SubscriptionTier?.ToUpper() ?? "STANDARD")
                    </span>
                    <button class="btn-logout" @onclick="Logout">Exit</button>
                </div>
            }
            else
            {
                <a href="https://personalization.dondlingergc.com" target="_blank" class="btn-auth-login">
                    🔑 LOG IN WITH PERSONALIZATION
                </a>
            }
        </div>
    </header>

    <main class="stage-container fade-in-text">
        <div class="spotlight"></div>
        <article class="content-body">
            @Body
        </article>
    </main>
</div>

@inject IdentityService Identity
@inject NavigationManager Nav

@code {
    protected override async Task OnInitializedAsync()
    {
        await Identity.InitializeAsync();
    }

    private async Task Logout()
    {
        await Identity.LogoutAsync();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}

<style>
    .app-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow-x: hidden;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 2rem;
        background: rgba(10, 10, 12, 0.95);
        border-bottom: 1px solid var(--surface-border);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .do-power-badge {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: linear-gradient(135deg, rgba(243, 128, 32, 0.12), rgba(157, 78, 221, 0.15));
        border: 1px solid rgba(243, 128, 32, 0.4);
        box-shadow: 0 0 15px rgba(243, 128, 32, 0.2), inset 0 0 10px rgba(157, 78, 221, 0.15);
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-family: 'Oswald', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 1px;
        backdrop-filter: blur(8px);
        transition: all 0.3s ease;
        position: relative;
    }

    .do-power-badge:hover {
        border-color: #f38020;
        box-shadow: 0 0 25px rgba(243, 128, 32, 0.5), 0 0 10px rgba(0, 240, 255, 0.4);
        transform: translateY(-1px);
    }

    .do-bolt {
        color: #f38020;
        font-size: 0.9rem;
        animation: boltPulse 1.5s infinite alternate ease-in-out;
        filter: drop-shadow(0 0 6px #f38020);
    }

    .do-label {
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
    }

    .do-highlight {
        color: #00f0ff;
        font-weight: 700;
        text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
        margin-left: 2px;
    }

    .do-glow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #00f0ff;
        box-shadow: 0 0 8px #00f0ff;
        animation: dotGlow 2s infinite ease-in-out;
    }

    @@keyframes boltPulse {
        0% { transform: scale(1); filter: drop-shadow(0 0 4px #f38020); }
        100% { transform: scale(1.25); filter: drop-shadow(0 0 10px #f38020) drop-shadow(0 0 15px #ffaa00); }
    }

    @@keyframes dotGlow {
        0%, 100% { opacity: 0.4; transform: scale(0.9); }
        50% { opacity: 1; transform: scale(1.3); }
    }

    .nav-links {
        display: flex;
        gap: 1rem;
    }

    .nav-links a {
        color: var(--text-secondary);
        text-decoration: none;
        font-family: 'Oswald', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 1px;
        transition: color 0.2s;
    }

    .nav-links a:hover {
        color: var(--neon-blue);
    }

    .header-right {
        display: flex;
        align-items: center;
    }

    .btn-auth-login {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        background: rgba(255, 215, 0, 0.15);
        border: 1px solid #ffd700;
        color: #ffd700;
        text-decoration: none;
        font-family: 'Oswald', sans-serif;
        font-size: 0.85rem;
        font-weight: bold;
        transition: all 0.2s;
    }

    .btn-auth-login:hover {
        background: #ffd700;
        color: black;
    }

    .user-pill {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255,255,255,0.05);
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        border: 1px solid var(--surface-border);
    }

    .user-email {
        font-size: 0.85rem;
        color: white;
    }

    .tier-badge {
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-weight: bold;
    }

    .tier-premium {
        background: #ffd700;
        color: black;
    }

    .tier-standard {
        background: var(--surface-border);
        color: var(--text-secondary);
    }

    .btn-logout {
        background: transparent;
        border: none;
        color: #ff3366;
        cursor: pointer;
        font-size: 0.75rem;
        padding: 0.2rem 0.4rem;
    }

    .logo {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .logo h1 {
        font-size: 1.8rem;
        margin: 0;
    }

    .logo-subtitle {
        font-family: 'Oswald', sans-serif;
        font-size: 0.65rem;
        color: var(--neon-purple);
        letter-spacing: 4px;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .stage-container {
        width: 100%;
        max-width: 100%;
        padding: 0;
        margin: 0;
    }

    .content-body {
        position: relative;
        z-index: 10;
        width: 100%;
        animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@media (max-width: 768px) {
        .app-header {
            flex-direction: column;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            align-items: stretch;
        }

        .header-left {
            justify-content: space-between;
            width: 100%;
            gap: 0.5rem;
        }

        .logo h1 {
            font-size: 1.4rem;
        }

        .logo-subtitle {
            font-size: 0.55rem;
            letter-spacing: 2px;
        }

        .nav-links {
            gap: 0.5rem;
        }

        .nav-links a {
            font-size: 0.75rem;
            padding: 0.3rem 0.5rem;
            background: rgba(255,255,255,0.05);
            border-radius: 6px;
        }

        .header-right {
            width: 100%;
            justify-content: center;
        }

        .user-pill {
            width: 100%;
            justify-content: space-between;
            font-size: 0.75rem;
        }

        .btn-auth-login {
            width: 100%;
            text-align: center;
            padding: 0.4rem 0.6rem;
            font-size: 0.75rem;
        }
    }
</style>

