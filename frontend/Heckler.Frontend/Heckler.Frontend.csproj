<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Heckler - MMO AI Comedy Club</Title>
    <AssemblyName>Heckler</AssemblyName>
    <Product>Heckler</Product>
    <Description>Live 24/7 MMO AI Standup Comedy Stage featuring interactive crowd reactions, live teleprompters, and custom co-listening VIP tables.</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <EmccMaximumHeapSize>268435456</EmccMaximumHeapSize>
    <BlazorCacheBootResources>false</BlazorCacheBootResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

</Project>
